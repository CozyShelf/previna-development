# Copie para .env e ajuste se necessario.

# --- App mobile (desenvolvimento) ---
# Celular fisico com Expo Go na mesma rede Wi-Fi: use o IP da sua maquina na LAN.
# MOBILE_HOST=192.168.0.10
# MOBILE_API_URL=http://192.168.0.10/backend

# --- Porta do nginx (desenvolvimento) ---
# Se a porta 80 da máquina já estiver em uso, publique o nginx em outra porta. Ajuste junto as URLs que a usam:
# NGINX_PORT=8080
# PORTAL_URL=http://localhost:8080
# MOBILE_API_URL=http://192.168.0.10:8080/backend
