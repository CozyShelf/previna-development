FROM node:22-bookworm-slim
WORKDIR /app

# Roda como "node" (uid 1000) para que arquivos gerados no volume (.expo/, expo-env.d.ts)
# nao fiquem com dono root no host
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json* ./
RUN npm ci

COPY --chown=node:node . .

# 8081: Metro bundler (Expo)
EXPOSE 8081
CMD ["npx", "expo", "start", "--port", "8081"]
